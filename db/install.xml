<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="question/type/clozeonimage/db" VERSION="20261019" COMMENT="XMLDB file for qtype_clozeonimage"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="qtype_clozeonimage" COMMENT="Options for Cloze on Image questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="formatversion" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="composition" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Versioned base rectangle x y width height, ratio lock and CSS background"/>
        <FIELD NAME="sequence" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Comma-separated IDs of wrapped Cloze subquestions"/>
        <FIELD NAME="showcomposition" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="introcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="aftercount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="displaymode" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 original size; 1 fit width"/>
        <FIELD NAME="displaywidth" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Stored composition width in CSS pixels; 0 means intrinsic width"/>
        <FIELD NAME="blockappearance" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="2" SEQUENCE="false"/>
        <FIELD NAME="controlappearance" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Answer control appearance: 0 translucent; 1 opaque"/>
        <FIELD NAME="aftertext" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Text displayed after the image composition"/>
        <FIELD NAME="aftertextformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign-unique" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="qtype_clozeonimage_pos" COMMENT="Positions of Cloze subquestions on the image">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="no" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Sequential subquestion number"/>
        <FIELD NAME="xleft" TYPE="number" LENGTH="20" DECIMALS="8" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="ytop" TYPE="number" LENGTH="20" DECIMALS="8" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="anchor" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="4" SEQUENCE="false" COMMENT="Control anchor from top left (0) to bottom right (8)"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Formatted block source containing Cloze expressions"/>
        <FIELD NAME="contentformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="width" TYPE="number" LENGTH="20" DECIMALS="8" NOTNULL="true" DEFAULT="320" SEQUENCE="false"/>
        <FIELD NAME="elementkey" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="relativeimage" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="relativex" TYPE="number" LENGTH="20" DECIMALS="8" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="relativey" TYPE="number" LENGTH="20" DECIMALS="8" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="layer" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="100" SEQUENCE="false"/>
        <FIELD NAME="stickybottom" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="stickytop" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="stickyhorizontal" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Bit mask: 1 left, 2 right, 3 both; 0 off"/>
        <FIELD NAME="slotcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Number of consecutive children in this block"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="question-no" UNIQUE="true" FIELDS="questionid, no"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="qtype_clozeonimage_img" COMMENT="Independent images; keys are stable within a question version">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="elementkey" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="xleft" TYPE="number" LENGTH="20" DECIMALS="8" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="ytop" TYPE="number" LENGTH="20" DECIMALS="8" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="width" TYPE="number" LENGTH="20" DECIMALS="8" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="height" TYPE="number" LENGTH="20" DECIMALS="8" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="layer" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="question-key" UNIQUE="true" FIELDS="questionid, elementkey"/></INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
